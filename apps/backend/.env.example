# ===========================================
# LLM Provider Configuration
# ===========================================
# Supported providers:
#   openai, openai_compatible, azure_foundry, anthropic, openrouter, gemini, deepseek, groq, ollama, codex
# openai_compatible = llama.cpp, vLLM, LM Studio, and any self-hosted server
# that exposes the OpenAI Chat Completions API. API key is optional for this
# provider (backend passes a sentinel when blank).
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-nano-2025-08-07
LLM_API_KEY=sk-your-api-key-here

# For Ollama (local models)
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma3:4b
# LLM_API_BASE=http://localhost:11434
#
# IMPORTANT: For Docker deployments with Ollama on host machine:
# Use host.docker.internal instead of localhost:
# LLM_API_BASE=http://host.docker.internal:11434
# (Works on macOS/Windows. On Linux, use your host IP or --network=host)

# For llama.cpp / vLLM / LM Studio (OpenAI-compatible local servers)
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=llama-3.1-8b  # or whatever model your server exposes
# LLM_API_BASE=http://localhost:8080/v1  # llama.cpp default; adjust per server
# LLM_API_KEY=  # leave blank if your server doesn't require auth

# For OpenRouter
# LLM_PROVIDER=openrouter
# LLM_MODEL=deepseek/deepseek-chat
# LLM_API_KEY=sk-or-v1-your-key

# For Azure AI Foundry / Azure AI Inference model endpoints
# LLM_PROVIDER=azure_foundry
# LLM_MODEL=mistral-large-latest
# LLM_API_BASE=https://<resource>.services.ai.azure.com/models
# LLM_API_KEY=your-azure-ai-foundry-key
#
# For Azure OpenAI GPT deployments in Azure AI Foundry, you can use the
# service root or paste the full v1 endpoint from Foundry; the backend will
# normalize it for LiteLLM:
# LLM_MODEL=gpt-5.4-mini
# LLM_API_BASE=https://<resource>.services.ai.azure.com/openai/v1/responses

# For the Codex CLI (local subprocess, not an HTTP endpoint)
#
# Codex is driven as a child process (`codex exec --json`) and holds its OWN
# credentials, so LLM_API_KEY / LLM_API_BASE / LLM_MODEL are all ignored for
# this provider. Sign in once on the machine (or in the container) with:
#     codex login
# and pick a model your account/CLI version actually serves (`codex` lists them
# interactively; `gpt-5.6-luna` and `gpt-5.5` are current examples).
#
# LLM_PROVIDER=codex
# CODEX_MODEL=gpt-5.6-luna
#
# Optional Codex settings:
# CODEX_BINARY=codex            # executable name or absolute path
# CODEX_HOME=                   # credentials + session dir (default: $CODEX_HOME, else ~/.codex)
# CODEX_WORKDIR=                # read-only workspace (default: an empty dir under data/)
#
# Notes:
#  * The bundled Docker image installs the CLI and sets
#    CODEX_HOME=/app/backend/data/.codex (on the persisted volume) so a login
#    survives restarts: `docker compose exec <service> codex login`.
#  * REASONING_EFFORT below is honored; "minimal" maps to Codex's "low".
#  * Remaining quota shown in Settings is read from Codex's own session files,
#    so runs are not ephemeral.

# For Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_API_KEY=sk-ant-your-key

# For Google Gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini/gemini-3-flash-preview
# LLM_API_KEY=your-gemini-key

# For DeepSeek
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=your-deepseek-key

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=8000
# Set RELOAD=true for `uv run app` to auto-reload on file changes (dev only)
RELOAD=false
# Reasoning effort for models that support it: minimal | low | medium | high
# Leave unset (or blank) for maximum provider compatibility. LiteLLM will
# drop this parameter for providers that don't support it.
# REASONING_EFFORT=
LOG_LEVEL=INFO
LOG_LLM=WARNING

# Frontend URL - Used for PDF generation
FRONTEND_BASE_URL=http://localhost:3000

# Hard timeout (seconds) for a single resume tailoring/improve request.
# Default 600. Raise it for slow local LLMs (Ollama, llama.cpp, ...); bounded
# to [30, 1800]. IMPORTANT: keep it in sync with the FRONTEND's
# NEXT_PUBLIC_REQUEST_TIMEOUT_MS (= this x1000) — the frontend Next.js proxy and
# client abort first if they're shorter, so raising only the backend has no
# effect (this is why issue #776's backend-only edit didn't work).
REQUEST_TIMEOUT_SECONDS=600

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ===========================================
# Authentication (Supabase, Google OAuth only)
# ===========================================
# Identity lives entirely in Supabase — this backend stores no users and no
# passwords. It verifies the access token Supabase issued to the browser and
# partitions every resume, job, tailoring and tracker card by the user id
# inside that token. Resume files themselves never leave this server: only the
# account identity is held by Supabase.
#
# Leave SUPABASE_URL blank for single-user local mode: no sign-in screen, and
# all data belongs to one implicit local account (the original behavior).
# Setting it is what switches the deployment into multi-user mode.
#
# The frontend needs the matching NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY (see apps/frontend/.env.example).

# Your Supabase project URL, e.g. https://abcxyzproject.supabase.co
# SUPABASE_URL=

# Only for projects still on legacy symmetric (HS256) JWTs:
# Project Settings -> API -> JWT Settings -> JWT Secret.
# New Supabase projects sign with asymmetric keys (ES256/RS256) and need
# nothing here — the backend verifies them against the project's JWKS endpoint.
# SUPABASE_JWT_SECRET=

# Override the JWKS endpoint. Derived from SUPABASE_URL when blank; you only
# need this for a self-hosted Supabase with a non-standard auth URL.
# SUPABASE_JWKS_URL=

# Refuse to start without a working Supabase configuration. Leave false for
# local development; set true for ANY deployment reachable by more than one
# person, so a blank/typo'd SUPABASE_URL crashes at startup instead of
# silently serving one shared data partition to every visitor.
AUTH_REQUIRED=false

# Lifetime (seconds) of the single-purpose token that lets the headless-Chromium
# PDF renderer read one resume back through the API. Bounded to [30, 3600];
# short by design, since it only has to survive one render.
PRINT_TOKEN_TTL_SECONDS=300
